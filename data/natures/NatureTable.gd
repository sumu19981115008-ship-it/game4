static func get_modifier(nature_id: int) -> Dictionary:
	var idx: int = clamp(nature_id, 0, NATURE_MODIFIERS.size() - 1)
	var m: Array = NATURE_MODIFIERS[idx]
	return {
		"attack_mult": m[0],
		"defense_mult": m[1],
		"sp_attack_mult": m[2],
		"sp_defense_mult": m[3],
		"speed_mult": m[4],
	}
